{
  "name": "xml-doc-color",
  "displayName": "XML Doc Color",
  "description": "Colorize XML documentation comments in C#, VB.NET, F#, Java, TypeScript, JavaScript, PHP and Kotlin",
  "version": "0.0.4",
  "publisher": "MindLated",
  "author": "MindLated",
  "homepage": "https://github.com/Sato-Isolated/xml-doc-color",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sato-Isolated/xml-doc-color.git"
  },
  "bugs": {
    "url": "https://github.com/Sato-Isolated/xml-doc-color/issues"
  },
  "license": "MIT",
  "icon": "img/image.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "xml",
    "doc",
    "comment",
    "semantic tokens",
    "csharp",
    "java",
    "javadoc",
    "jsdoc",
    "tsdoc",
    "phpdoc",
    "kdoc",
    "kotlin",
    "color",
    "highlight"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xml-doc-color-sidebar",
          "title": "XML Doc Color",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "xmlDocColor.openColorPicker",
        "title": "Open Color Picker",
        "category": "XML Doc Color"
      },
      {
        "command": "xmlDocColor.toggleEnabled",
        "title": "Toggle Enabled",
        "category": "XML Doc Color"
      },
      {
        "command": "xmlDocColor.copyThemeRules",
        "title": "Copy Theme Customization JSON",
        "category": "XML Doc Color"
      },
      {
        "command": "xmlDocColor.openThemeSnippet",
        "title": "Open Theme Customization Snippet",
        "category": "XML Doc Color"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xmlDocColor.openColorPicker",
          "when": "editorLangId == csharp || editorLangId == vb || editorLangId == fsharp || editorLangId == java || editorLangId == typescript || editorLangId == javascript || editorLangId == php || editorLangId == kotlin"
        },
        {
          "command": "xmlDocColor.toggleEnabled"
        },
        {
          "command": "xmlDocColor.copyThemeRules"
        },
        {
          "command": "xmlDocColor.openThemeSnippet"
        }
      ]
    },
    "views": {
      "xml-doc-color-sidebar": [
        {
          "type": "webview",
          "id": "xmlDocColor.colorPicker",
          "name": "Color Picker"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "xmlDocTagDelimiter",
        "superType": "operator",
        "description": "Delimiter characters of an XML doc tag: <, >, </, />, <!--, -->"
      },
      {
        "id": "xmlDocTagName",
        "superType": "type",
        "description": "Name of an XML doc tag, e.g. summary, param, returns"
      },
      {
        "id": "xmlDocAttribute",
        "superType": "property",
        "description": "Attribute name inside an XML doc tag, e.g. name, cref, href"
      },
      {
        "id": "xmlDocAttributeValue",
        "superType": "string",
        "description": "Attribute value inside an XML doc tag, e.g. \"paramName\""
      },
      {
        "id": "xmlDocAtTag",
        "superType": "keyword",
        "description": "@-style doc tag, e.g. @param, @returns, @link"
      },
      {
        "id": "xmlDocLinePrefix",
        "superType": "comment",
        "description": "Doc comment line prefix marker: ///, ''', *, /**, */"
      },
      {
        "id": "xmlDocText",
        "superType": "comment",
        "description": "Plain text content in a doc comment (outside XML tags and @-tags)"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "xmlDocTagDelimiter": [
            "punctuation.definition.tag"
          ],
          "xmlDocTagName": [
            "entity.name.tag"
          ],
          "xmlDocAttribute": [
            "entity.other.attribute-name"
          ],
          "xmlDocAttributeValue": [
            "string.quoted.double"
          ],
          "xmlDocAtTag": [
            "keyword.other.documentation",
            "storage.type.annotation"
          ],
          "xmlDocLinePrefix": [
            "punctuation.definition.comment"
          ],
          "xmlDocText": [
            "comment"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[csharp]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[vb]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[fsharp]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[java]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[typescript]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[javascript]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[php]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[kotlin]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "XML Doc Color",
      "properties": {
        "xmlDocColor.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "markdownDescription": "Enable XML documentation comment colorization. Can be overridden per language in workspace settings."
        },
        "xmlDocColor.enabledLanguages": {
          "type": "array",
          "default": [
            "csharp",
            "vb",
            "fsharp",
            "java",
            "typescript",
            "javascript",
            "php",
            "kotlin"
          ],
          "items": {
            "type": "string",
            "enum": [
              "csharp",
              "vb",
              "fsharp",
              "java",
              "typescript",
              "javascript",
              "php",
              "kotlin"
            ]
          },
          "markdownDescription": "Subset of supported languages where XML Doc Color should stay active."
        },
        "xmlDocColor.showStatusItem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the XML Doc Color language status item when a supported editor is open."
        },
        "xmlDocColor.configurationTarget": {
          "type": "string",
          "default": "global",
          "enum": [
            "global",
            "workspace"
          ],
          "markdownEnumDescriptions": [
            "Write color overrides and toggles to your global user settings.",
            "Write color overrides and toggles to the current workspace settings."
          ],
          "markdownDescription": "Where XML Doc Color should persist settings changed from commands or the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "vsce package --out xml-doc-color.vsix",
    "vsix:install": "npm run vsix && code --install-extension xml-doc-color.vsix --force",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
