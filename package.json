{
  "name": "xml-doc-color",
  "displayName": "XML Doc Color",
  "description": "Colorize XML documentation and ordinary block comments with TextMate scopes in C#, VB.NET, F#, Java, TypeScript, TSX, JavaScript, JSX, PHP and Kotlin",
  "version": "0.1.0",
  "publisher": "MindLated",
  "author": "MindLated",
  "homepage": "https://github.com/Sato-Isolated/xml-doc-color",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sato-Isolated/xml-doc-color.git"
  },
  "bugs": {
    "url": "https://github.com/Sato-Isolated/xml-doc-color/issues"
  },
  "license": "MIT",
  "icon": "img/image.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "xml",
    "doc",
    "comment",
    "textmate",
    "csharp",
    "java",
    "javadoc",
    "jsdoc",
    "tsdoc",
    "phpdoc",
    "kdoc",
    "kotlin",
    "color",
    "highlight"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:csharp",
    "onLanguage:vb",
    "onLanguage:fsharp",
    "onLanguage:java",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:php",
    "onLanguage:kotlin"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xml-doc-color-sidebar",
          "title": "XML Doc Color",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "xml-doc-color-sidebar": [
        {
          "type": "webview",
          "id": "xmlDocColor.colorPicker",
          "name": "Color Picker"
        }
      ]
    },
    "commands": [
      {
        "command": "xmlDocColor.openColorPicker",
        "title": "Open Color Picker",
        "category": "XML Doc Color"
      },
      {
        "command": "xmlDocColor.copyThemeRules",
        "title": "Copy TextMate Customization JSON",
        "category": "XML Doc Color"
      },
      {
        "command": "xmlDocColor.openThemeSnippet",
        "title": "Open TextMate Customization Snippet",
        "category": "XML Doc Color"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xmlDocColor.openColorPicker",
          "when": "editorLangId == csharp || editorLangId == vb || editorLangId == fsharp || editorLangId == java || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == php || editorLangId == kotlin"
        },
        {
          "command": "xmlDocColor.copyThemeRules"
        },
        {
          "command": "xmlDocColor.openThemeSnippet"
        }
      ]
    },
    "grammars": [
      {
        "scopeName": "xml-doc-color.csharp.injection",
        "path": "./dist/syntaxes/csharp.tmLanguage.json",
        "injectTo": [
          "source.cs"
        ]
      },
      {
        "scopeName": "xml-doc-color.vb.injection",
        "path": "./dist/syntaxes/vb.tmLanguage.json",
        "injectTo": [
          "source.asp.vb.net"
        ]
      },
      {
        "scopeName": "xml-doc-color.fsharp.injection",
        "path": "./dist/syntaxes/fsharp.tmLanguage.json",
        "injectTo": [
          "source.fsharp"
        ]
      },
      {
        "scopeName": "xml-doc-color.java.injection",
        "path": "./dist/syntaxes/java.tmLanguage.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "xml-doc-color.java.regular-block.injection",
        "path": "./dist/syntaxes/java.block.tmLanguage.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "xml-doc-color.typescript.injection",
        "path": "./dist/syntaxes/typescript.tmLanguage.json",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "scopeName": "xml-doc-color.typescript.regular-block.injection",
        "path": "./dist/syntaxes/typescript.block.tmLanguage.json",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "scopeName": "xml-doc-color.typescriptreact.injection",
        "path": "./dist/syntaxes/typescriptreact.tmLanguage.json",
        "injectTo": [
          "source.tsx"
        ]
      },
      {
        "scopeName": "xml-doc-color.typescriptreact.regular-block.injection",
        "path": "./dist/syntaxes/typescriptreact.block.tmLanguage.json",
        "injectTo": [
          "source.tsx"
        ]
      },
      {
        "scopeName": "xml-doc-color.javascript.injection",
        "path": "./dist/syntaxes/javascript.tmLanguage.json",
        "injectTo": [
          "source.js"
        ]
      },
      {
        "scopeName": "xml-doc-color.javascript.regular-block.injection",
        "path": "./dist/syntaxes/javascript.block.tmLanguage.json",
        "injectTo": [
          "source.js"
        ]
      },
      {
        "scopeName": "xml-doc-color.javascriptreact.injection",
        "path": "./dist/syntaxes/javascriptreact.tmLanguage.json",
        "injectTo": [
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "xml-doc-color.javascriptreact.regular-block.injection",
        "path": "./dist/syntaxes/javascriptreact.block.tmLanguage.json",
        "injectTo": [
          "source.js.jsx"
        ]
      },
      {
        "scopeName": "xml-doc-color.php.injection",
        "path": "./dist/syntaxes/php.tmLanguage.json",
        "injectTo": [
          "source.php",
          "text.html.php"
        ]
      },
      {
        "scopeName": "xml-doc-color.php.regular-block.injection",
        "path": "./dist/syntaxes/php.block.tmLanguage.json",
        "injectTo": [
          "source.php",
          "text.html.php"
        ]
      },
      {
        "scopeName": "xml-doc-color.kotlin.injection",
        "path": "./dist/syntaxes/kotlin.tmLanguage.json",
        "injectTo": [
          "source.kotlin"
        ]
      },
      {
        "scopeName": "xml-doc-color.kotlin.regular-block.injection",
        "path": "./dist/syntaxes/kotlin.block.tmLanguage.json",
        "injectTo": [
          "source.kotlin"
        ]
      }
    ],
    "configuration": {
      "title": "XML Doc Color",
      "properties": {
        "xmlDocColor.showStatusItem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the XML Doc Color language status item when a supported editor is open."
        },
        "xmlDocColor.configurationTarget": {
          "type": "string",
          "default": "global",
          "enum": [
            "global",
            "workspace"
          ],
          "markdownEnumDescriptions": [
            "Write TextMate color overrides to your global user settings.",
            "Write TextMate color overrides to the current workspace settings."
          ],
          "markdownDescription": "Where XML Doc Color should persist colors changed from commands or the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "generate-grammars": "tsx src/generateGrammars.ts",
    "compile": "npm run check-types && npm run lint && npm run generate-grammars && node esbuild.js",
    "prewatch": "npm run generate-grammars",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run generate-grammars && node esbuild.js --production",
    "vsix": "vsce package --out xml-doc-color.vsix",
    "vsix:install": "npm run vsix && code --install-extension xml-doc-color.vsix --force",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "pretest:webview": "npm run compile-tests && npm run compile",
    "pretest:web": "npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vscode-test --timeout 10000",
    "test:desktop:min": "vscode-test --code-version 1.74.0 --timeout 10000",
    "test:desktop:stable": "vscode-test --timeout 10000",
    "test:webview": "playwright test test/webview.spec.cjs",
    "test:web": "vscode-test-web --quality stable --browser=chromium --esm=true --port=3025 --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/smoke.js",
    "test:all": "npm-run-all test test:webview test:web"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.1"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    }
  }
}
